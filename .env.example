OPENAI_API_KEY=                        # your OpenAI key — required when USE_OPENAI=true
OPENAI_MODEL=gpt-4.1-mini
USE_OPENAI=false                       # set to true to enable LLM claim extraction + risk scoring
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# API Key authentication (leave blank for open dev mode)
API_KEY=                               # e.g. mfw-supersecretkey123

# Databases
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/memory_firewall
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Burst-write detection (AuditService)
BURST_WINDOW_SECONDS=60               # rolling window length in seconds
BURST_MAX_WRITES=10                   # max writes within the window before flagging burst

# Retrieval security
RETRIEVAL_MEDIUM_TRUST_FLOOR=0.6      # min trust score served on medium-threat credential queries

# PII / Sensitive Data Redaction
ENABLE_PII_REDACTION=true             # set to true to redact email, phone, and API keys/secrets from incoming memories

